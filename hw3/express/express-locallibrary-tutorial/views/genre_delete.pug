extends layout

block content
  h1 #{title}: #{genre.name}

  if genre_books.length
    p #[strong This record cannot be deleted until the following books have been deleted.]
    ul
      each item in genre_books
        li
          a(href=item.url) #{item.title}
  else
    p Do you really want to delete this Genre?
    form(method='POST')
      button.btn.btn-primary(type='submit') Delete
