extends layout

block content
  h1 #{title}: #{book.title}

  if book_instances.length
    p #[strong This record cannot be deleted until the following book copies have been deleted.]
    ul
      each item in book_instances
        li
          a(href=item.url) #{item._id} — #{item.imprint} (#{item.status})
  else
    p Do you really want to delete this Book?
    form(method='POST')
      button.btn.btn-primary(type='submit') Delete
